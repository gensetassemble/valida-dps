    "lucide-react": "1.62.0",
    "tailwindcss": "4.3.3",
    "tailwind-merge": "3.7.0",
    "next": "16.4.3",
    "radix-ui": "1.8.1",
    "react-dom": "19.3.1",
    "@hookform/resolvers": "6.0.1",
    "react-hook-form": "7.91.0",
    "@supabase/supabase-js": "2.118.0",
    "@supabase/ssr": "0.12.7",
    "server-only": "0.0.1",
    "@microsoft/microsoft-graph-client": "3.0.7",
    "@fontsource/public-sans": "5.3.0",
    "@azure/msal-node": "7.1.2",
