    "@tailwindcss/postcss": "4.3.3"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "eslint": "10.13.0",
    "tw-animate-css": "1.4.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.5",
    "supabase": "2.122.0",
    "@types/react": "19.3.0",
    "@playwright/test": "1.64.1",
    "vitest": "5.0.5",
    "@next/eslint-plugin-next": "16.4.3",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.72.1",
    "eslint-plugin-react-hooks": "7.1.1"
  },
  "type": "module"
}
