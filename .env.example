# VALIDA APPLICATION — WITA
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=VALIDA
NEXT_PUBLIC_BRANCH_CODE=DPS
APP_TIMEZONE=Asia/Makassar
# SUPABASE — hanya publishable key boleh masuk browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Tidak diperlukan aplikasi tahap 01–04; jangan berikan ke preview publik
SUPABASE_SECRET_KEY=
# Impor CSV/XLSX privat: 5 MiB / 2.500 baris; PDF privat: 10 MiB.
# Commit impor saat ini dibatasi pada ref development yang disetujui di server.
# MICROSOFT 365 — belum diotorisasi
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
OUTLOOK_NOTIFICATION_MAILBOX=
ENABLE_OUTLOOK_EMAIL=false
ENABLE_OUTLOOK_COMMERCIAL=false
# Belum ada cron aktif
CRON_SECRET=
