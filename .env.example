# VALIDA APPLICATION — WITA
APP_URL=http://localhost:3000
APP_ENVIRONMENT=development
NEXT_PUBLIC_APP_NAME=VALIDA
NEXT_PUBLIC_BRANCH_CODE=DPS
APP_TIMEZONE=Asia/Makassar
# SUPABASE — hanya publishable key boleh masuk browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server saja: diperlukan untuk pembuatan/reset password oleh Super Admin.
# Gunakan secret key dari proyek yang sama dengan URL publik di atas.
# Jangan gunakan prefiks NEXT_PUBLIC_ untuk kunci ini.
SUPABASE_SECRET_KEY=
# Impor CSV/XLSX privat: 5 MiB / 2.500 baris; PDF privat: 10 MiB.
# Commit impor hanya di development. Jangan gunakan proyek produksi untuk localhost.
# MICROSOFT 365 — belum diotorisasi
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
OUTLOOK_NOTIFICATION_MAILBOX=
ENABLE_OUTLOOK_EMAIL=false
ENABLE_OUTLOOK_COMMERCIAL=false
# Server-only allowlist for future internal tests. Only @sucofindo.co.id addresses.
# This does not enable delivery; mailbox authorization and delivery audit are not active.
VALIDA_EMAIL_TEST_RECIPIENTS=
# Belum ada cron aktif
CRON_SECRET=
