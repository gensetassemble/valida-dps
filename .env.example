# VALIDA APPLICATION — WITA
APP_URL=http://localhost:3000
APP_ENVIRONMENT=development
NEXT_PUBLIC_APP_NAME=VALIDA
NEXT_PUBLIC_BRANCH_CODE=DPS
APP_TIMEZONE=Asia/Makassar
# SUPABASE — hanya publishable key boleh masuk browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server saja: diperlukan untuk pembuatan/reset password oleh Super Admin.
# Gunakan secret key dari proyek yang sama dengan URL publik di atas.
# Jangan gunakan prefiks NEXT_PUBLIC_ untuk kunci ini.
SUPABASE_SECRET_KEY=
# Impor CSV/XLSX privat: 5 MiB / 2.500 baris; PDF privat: 10 MiB.
# Commit impor hanya di development. Jangan gunakan proyek produksi untuk localhost.
# MICROSOFT 365 — application identity; restrict Exchange RBAC to one mailbox.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
OUTLOOK_NOTIFICATION_MAILBOX=
ENABLE_OUTLOOK_EMAIL=false
ENABLE_OUTLOOK_COMMERCIAL=false
# disabled | test | live. Live is rejected outside the production environment.
# Test delivery always goes to adli.alfian@sucofindo.co.id, never a customer PIC.
VALIDA_MAIL_MODE=disabled
ENABLE_EMAIL_REMINDERS=false
# Legacy preview allowlist; direct test delivery remains fixed to Adli.
VALIDA_EMAIL_TEST_RECIPIENTS=
# Server-only random value, at least 32 characters. Never commit the real value.
# Cron: daily 00:00 UTC / 08:00 WITA. Switches and branch settings default off.
CRON_SECRET=
